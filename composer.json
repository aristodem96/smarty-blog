{
    "name": "aristodem/smarty-blog",
    "description": "Simple blog with categories and articles on plain PHP, MySQL and Smarty",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\Seeders\\": "database/seeds/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
