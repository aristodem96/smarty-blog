# Optional: copy to .env to override the defaults from docker-compose.yml.
APP_PORT=8080
# development = Smarty recompiles changed templates; production = no per-request template checks.
APP_ENV=development
# 1 = show exception details on the 500 page (local development only).
APP_DEBUG=0

DB_NAME=blog
DB_USER=blog
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_EXTERNAL_PORT=3307
